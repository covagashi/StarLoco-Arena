{
  "name": "dofusarena-2.70-studio-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "fmt": "oxfmt src index.html vite.config.ts",
    "fmt:check": "oxfmt --check src index.html vite.config.ts",
