    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm knip"
  },
  "devDependencies": {
    "knip": "6.41.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "packageManager": "pnpm@12.14.0"
}
