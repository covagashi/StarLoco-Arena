extends RefCounted

## Windows-1252 encode/decode for wire strings.
##
## The Go server decodes login/password/coach-name as cp1252
## (internal/protocol/text.go). Identical to Latin-1 except the 0x80–0x9F
## range, mapped here. ASCII passes through unchanged.

const _HIGH := {
	0x20AC: 0x80, 0x201A: 0x82, 0x0192: 0x83, 0x201E: 0x84, 0x2026: 0x85,
	0x2020: 0x86, 0x2021: 0x87, 0x02C6: 0x88, 0x2030: 0x89, 0x0160: 0x8A,
	0x2039: 0x8B, 0x0152: 0x8C, 0x017D: 0x8E, 0x2018: 0x91, 0x2019: 0x92,
	0x201C: 0x93, 0x201D: 0x94, 0x2022: 0x95, 0x2013: 0x96, 0x2014: 0x97,
	0x02DC: 0x98, 0x2122: 0x99, 0x0161: 0x9A, 0x203A: 0x9B, 0x0153: 0x9C,
	0x017E: 0x9E, 0x0178: 0x9F,
}

const _HIGH_DECODE := {
	0x80: 0x20AC, 0x82: 0x201A, 0x83: 0x0192, 0x84: 0x201E, 0x85: 0x2026,
	0x86: 0x2020, 0x87: 0x2021, 0x88: 0x02C6, 0x89: 0x2030, 0x8A: 0x0160,
	0x8B: 0x2039, 0x8C: 0x0152, 0x8E: 0x017D, 0x91: 0x2018, 0x92: 0x2019,
	0x93: 0x201C, 0x94: 0x201D, 0x95: 0x2022, 0x96: 0x2013, 0x97: 0x2014,
	0x98: 0x02DC, 0x99: 0x2122, 0x9A: 0x0161, 0x9B: 0x203A, 0x9C: 0x0153,
	0x9E: 0x017E, 0x9F: 0x0178,
}


## String -> cp1252 bytes. Characters outside cp1252 become '?'.
static func encode(s: String) -> PackedByteArray:
	var out := PackedByteArray()
	for c in s:
		var cp := c.unicode_at(0)
		if cp < 0x80 or (cp >= 0xA0 and cp <= 0xFF):
			out.append(cp)
		elif _HIGH.has(cp):
			out.append(_HIGH[cp])
		else:
			out.append(0x3F)  # '?'
	return out


## cp1252 bytes -> String.
static func decode(b: PackedByteArray) -> String:
	var out := ""
	for byte in b:
		if byte < 0x80 or byte >= 0xA0:
			out += char(byte)
		elif _HIGH_DECODE.has(byte):
			out += char(_HIGH_DECODE[byte])
		else:
			out += char(byte)
	return out
