; Engine configuration file.
; DofusArena 2.70 — Godot client. Wire-compatible with server/ (Go).

config_version=5

[application]

config/name="Pippop Arena"
; The name players see (the browser tab, the window). The saved data keeps
; its old folder (user://: settings and, in the browser, the demo account),
; so renaming the game did not sign anybody out.
config/use_custom_user_dir=true
config/custom_user_dir_name="godot/app_userdata/StarLoco Arena"
run/main_scene="res://src/main.tscn"
run/main_scene.web="res://src/web/web_boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
; S44: the loading splash (vex, godot/tools/splash/splash.vx.js), also what
; the browser shows while it downloads the engine
boot_splash/image="res://src/web/splash.png"
boot_splash/bg_color=Color(0.9137, 0.9176, 0.9451, 1)
boot_splash/fullsize=true
boot_splash/use_filter=true

[audio]

; S44: in the browser Godot 4.7 plays every stream as a Web Audio "sample"
; by default, which decodes it whole into float PCM in JavaScript (a few
; minutes of music is tens of MB). Streams mix in the audio worklet instead.
general/default_playback_type.web=0
; A stream is mixed on the main thread (the web build has no other), so a
; frame longer than the output buffer cut the music: opening and closing the
; inventory on a phone still did at 250 ms. The music can wait half a
; second; the short sounds are samples (audio.gd SHORT) and don't wait.
driver/output_latency.web=500

[autoload]

I18n="*res://src/i18n/i18n.gd"
Session="*res://src/session.gd"
Audio="*res://src/audio/audio.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

; Required by the macOS arm64 / universal export (Godot refuses the preset
; without it). Harmless elsewhere: it only adds ETC2/ASTC variants for the
; handful of imported PNGs under assets/ui.
textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
